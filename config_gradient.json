{
    "path": "gradient_models/",
    "model": 
    {
        "num_channels": 2,
        "ch": 64,
        "out_ch": 2,
        "ch_mult": [1, 2],
        "num_res": 2,
        "attn_layers": [],
        "attn_middle": false,
        "dropout": 0.1,
        "resamp_with_conv": true
    },
    "diffusion": 
    {
        "betas": {
            "min": 1e-4,
            "max": 1e-2,
            "count": 1000,
            "schedule": "linear"
        },
        "loss": "mse"
    },
    "train": 
    {
        "dataset": "gradient_dataset.hdf5",
        "samplers": ["gradients"],
        "batch_size": 8,
        "ema_decay": 0.995,
        "ema_update_every": 25,
        "lr": 1e-4
    },
    "eval": 
    {
        "directory": "eval/",
        "freq": 5000,
        "ts": [100, 500]
    }
}
